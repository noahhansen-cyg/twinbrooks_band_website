# Flask session signing. Required in production, any value works in dev.
SECRET_KEY=change-me

# Resend API key. Leave blank in dev — contact and booking submissions are
# logged to the console instead of emailed.
RESEND_API_KEY=

# Where booking inquiries are delivered.
MAIL_RECIPIENT=noah.hansen1323@gmail.com

# Sender address. Using a custom domain requires verifying it with Resend;
# onboarding@resend.dev works without any setup.
MAIL_FROM=onboarding@resend.dev

# development | production
FLASK_ENV=development
